# ==============================================================================
# LINE 門市營運系統環境變數設定檔 (.env)
# 說明：請依據以下欄位指引填入各平台的憑證金鑰。
# 填入完成後，系統將自動以此設定與 LINE / LINE Pay / PostgreSQL 連線。
# 若在本地開發且尚未取得正式 Key，可保持 MOCK_LINE_SERVICES=true 進行全功能本機模擬。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基礎伺服器與資料庫設定
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# 應用程式對外基礎 URL (LIFF 跳轉、LINE Pay Confirm 回呼、邀請連結皆以此為根網址)
# 本地開發請設為 http://localhost:3000 或 ngrok / cloudflare tunnel 網址
# 上線請改為正式域名，例如：https://line-store.yourdomain.com
APP_BASE_URL=http://localhost:3000

# 系統內部 JWT / Session 加密密鑰 (請替換為 32 字元以上之隨機雜湊字串)
SESSION_SECRET=super_secret_session_key_please_change_in_production_32chars_min

# PostgreSQL 資料庫連線字串 (可使用本機 PostgreSQL、Supabase、Neon、Railway、Render 或 Docker)
# 格式：postgresql://[使用者名稱]:[密碼]@[主機位址]:[埠號]/[資料庫名稱]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/line_queue_db?schema=public"

# Redis 快取與分散式鎖連線 (正式多節點部署建議啟用，單節點本機開發可選)
# REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. LINE 模擬模式開關 (開發者友善)
# ------------------------------------------------------------------------------
# 當設為 true 時，即使未填寫或尚未申請下方 LINE 相關 Key，
# 系統將啟用本機模擬 (Mock Login, Mock Messaging, Mock LINE Pay)，可直接測試所有業務流程。
# 當您在下方填入真實金鑰並將其改為 false 時，系統即無縫對接 LINE 官方真實 API。
MOCK_LINE_SERVICES=true

# ------------------------------------------------------------------------------
# 3. LINE Login & LIFF SDK 設定
# 取得來源：LINE Developers Console (https://developers.line.biz/console/)
# 步驟：建立 Provider -> Create a new channel -> 選擇「LINE Login」
# ------------------------------------------------------------------------------
# 1. LINE Login Channel ID (Basic settings 分頁)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id

# 2. LINE Login Channel Secret (Basic settings 分頁)
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret

# 3. LIFF App ID (LIFF 分頁 -> Add LIFF app -> 取得 LIFF ID)
# 格式如：1234567890-abcdefgh
NEXT_PUBLIC_LIFF_ID=your_liff_app_id

# ------------------------------------------------------------------------------
# 4. LINE Official Account & Messaging API 設定
# 取得來源：LINE Developers Console -> 選擇「Messaging API」Channel
# ------------------------------------------------------------------------------
# 1. Messaging API Channel ID
LINE_MESSAGING_CHANNEL_ID=your_messaging_channel_id

# 2. Messaging API Channel Secret (用於校驗 LINE Webhook HMAC-SHA256 簽名)
LINE_MESSAGING_CHANNEL_SECRET=your_messaging_channel_secret

# 3. Channel Access Token (長期權杖，於 Messaging API 分頁最下方「Issue」生成)
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your_messaging_channel_access_token_long_lived

# 4. Webhook 路徑說明：
# 在 Messaging API 分頁的 Webhook settings 中填入：
# https://[你的網域]/api/v1/webhooks/line
# 並開啟「Use webhook」開關。

# ------------------------------------------------------------------------------
# 5. LINE Per-User Rich Menu (圖文選單 ID)
# 說明：系統支援依角色自動切換 Rich Menu。
# 可透過官方 LINE Official Account Manager 建立後複製 ID，或由系統部署腳本動態建立。
# ------------------------------------------------------------------------------
# 預設訪客/顧客選單 ID
LINE_RICHMENU_DEFAULT_ID=richmenu-default-customer-id

# 店員 (Staff) 專屬叫號管理選單 ID
LINE_RICHMENU_STAFF_ID=richmenu-staff-id

# 店長 (Manager) 營運設定選單 ID
LINE_RICHMENU_MANAGER_ID=richmenu-manager-id

# 店家負責人 (Owner) 最高權限選單 ID
LINE_RICHMENU_OWNER_ID=richmenu-owner-id

# ------------------------------------------------------------------------------
# 6. LINE Pay Online API v4 設定
# 取得來源：LINE Pay 商家中心 (Sandbox: https://pay.line.me/tw/devtools/sandbox)
# 或正式商家後台 -> 交易資訊管理 -> 付款連結金鑰管理
# ------------------------------------------------------------------------------
# LINE Pay 特店 Channel ID
LINE_PAY_CHANNEL_ID=your_line_pay_channel_id

# LINE Pay 特店 Channel Secret Key (請妥善保管，嚴禁外洩至前端)
LINE_PAY_CHANNEL_SECRET=your_line_pay_channel_secret

# LINE Pay API Gateway 網址
# 測試沙盒環境：https://sandbox-api-pay.line.me
# 正式商業環境：https://api-pay.line.me
LINE_PAY_API_BASE_URL=https://sandbox-api-pay.line.me

# ------------------------------------------------------------------------------
# 7. 監控與日誌 (選填)
# ------------------------------------------------------------------------------
# Sentry 錯誤追蹤 (可選)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
