generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  lineUid              String        @unique
  displayName          String?
  avatarUrl            String?
  notificationsEnabled Boolean       @default(true)
  createdAt            DateTime      @default(now())
  projects             Project[]     @relation("InitiatorProjects")
  memberships          Membership[]
  transactions         Transaction[]
}

model Project {
  id           String       @id @default(uuid())
  initiatorId  String
  name         String
  amount       Decimal      @db.Decimal(10, 2)
  payDay       Int
  paymentLink  String
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  initiator    User         @relation("InitiatorProjects", fields: [initiatorId], references: [id])
  memberships  Membership[]
  transactions Transaction[]
}

model Membership {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("PAYER")
  joinedAt  DateTime @default(now())
  status    String   @default("ACTIVE")
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Transaction {
  id           String    @id @default(uuid())
  projectId    String
  payerId      String
  billingMonth String
  amount       Decimal   @db.Decimal(10, 2)
  status       String    @default("UNPAID")
  notifiedAt   DateTime?
  paidAt       DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime  @default(now())
  project      Project   @relation(fields: [projectId], references: [id])
  payer        User      @relation(fields: [payerId], references: [id])

  @@unique([projectId, payerId, billingMonth])
}
