# ==============================================================================
# LINE 批次退群與群組管家工具 - 環境變數設定範例檔 (.env.example)
# 
# 使用說明：
# 1. 複製此檔案並重新命名為 `.env`：cp .env.example .env
# 2. 將下方的各項 Token、金鑰與設定值替換為您的實際憑證
# 3. 請妥善保管 `.env` 檔案，切勿將包含私密金鑰的 .env 提交至 Git 公開儲存庫
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 服務基礎與安全性設定 (Server & Security Configuration)
# ------------------------------------------------------------------------------
# 伺服器運作環境：development (開發) / production (正式)
ENVIRONMENT=development

# 伺服器監聽 Port
PORT=8000

# 伺服器公開網址（提供 LINE Webhook 與異議終止網頁回呼）
# 正式環境填寫您的 HTTPS 域名，本機開發可使用 ngrok (如: https://xxxx.ngrok-free.app)
APP_BASE_URL=https://your-domain.com

# 用於產生與驗證取消解散 Token 的安全密鑰 (HMAC-SHA256 Secret)
# 請產生一組隨機高強度字串 (例如: openssl rand -hex 32)
SECURITY_SECRET_KEY=your_super_secret_hmac_key_here

# 3 天緩衝公示預設倒數時數（預設 72 小時）
DISBAND_NOTICE_HOURS=72


# ------------------------------------------------------------------------------
# 2. LINE Developers 官方帳號與 Bot 設定 (LINE Messaging API)
# 取得方式：至 LINE Developers Console (https://developers.line.biz/) 建立 Messaging API Channel
# ------------------------------------------------------------------------------
# Messaging API Channel Secret (於 Basic settings 頁面取得，用於 Webhook 簽名驗證)
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Messaging API 長期 Channel Access Token (於 Messaging API 頁面「Issue」產生)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE 官方機器人 Basic ID 或 帳號名稱 (例如: @123abcde)
# 供桌面自動化程式搜尋並邀請機器人入群使用
LINE_BOT_BASIC_ID=@your_bot_line_id

# LINE LIFF ID (選配/推薦，於 LINE Developers 建立 LIFF 應用取得)
# 格式為：{liff_app_id}，用於在 LINE 內開啟精美原生的兩階段終止確認介面
LINE_LIFF_ID=1234567890-AbCdEfGh


# ------------------------------------------------------------------------------
# 3. Google Sheets 資料庫設定 (Google Cloud Platform)
# 取得方式：
# 1. 前往 Google Cloud Console (https://console.cloud.google.com/)
# 2. 建立 GCP 專案並啟用「Google Sheets API」與「Google Drive API」
# 3. 於「憑證」頁面建立「服務帳號 (Service Account)」並下載 JSON 私鑰檔
# 4. 建立 Google 試算表，並將試算表「共用 (Share)」給該服務帳號之 Email (給予編輯者權限)
# ------------------------------------------------------------------------------
# 目標 Google Sheet 試算表 ID
# 取得方式：試算表網址 https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# 方式 A：指定本機 Google 服務帳號憑證 JSON 檔案路徑 (推薦本機開發使用)
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# 方式 B：直接將 GCP Service Account JSON 內容轉為字串或 Base64 (推薦雲端無伺服器/Docker部署使用)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}


# ------------------------------------------------------------------------------
# 4. 本機桌面自動化設定 (Windows Desktop Client)
# ------------------------------------------------------------------------------
# LINE Windows 電腦版安裝執行檔路徑 (若為預設路徑可留空)
LINE_DESKTOP_PATH=C:\Users\Username\AppData\Local\LINE\bin\LINE.exe

# 視窗自動化操作間隔隨機延遲時間 (秒)，避免觸發 LINE 防刷機制
MIN_ACTION_DELAY_SECONDS=1.5
MAX_ACTION_DELAY_SECONDS=3.5
