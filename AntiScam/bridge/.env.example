# Configure in server-side environment only; never commit actual values.
# Run mars-tw/anti-scam-helper (Apache-2.0) separately with api.moderation enabled.
LINEJS_WS_URL=ws://127.0.0.1:3789/api/ws
LINEJS_API_TOKEN=REPLACE_WITH_UPSTREAM_CLI_GENERATED_BOT_TOKEN
ANTISCAM_API_URL=http://127.0.0.1:3000
OPENCHAT_CHAT_IDS=REPLACE_WITH_REAL_OPENCHAT_ROOM_ID
WEBHOOK_SECRET=REPLACE_WITH_THE_EXACT_SAME_WEBHOOK_SECRET_USED_BY_ANTISCAM_API
OPENCHAT_BRIDGE_TOKEN=REPLACE_WITH_UNIQUE_32_PLUS_BYTE_RANDOM_SECRET
OPENCHAT_BRIDGE_PORT=3010
# Both stay false until real testing and administrator approval.
OPENCHAT_LIVE_VERIFIED=false
OPENCHAT_ACTIONS_ENABLED=false
# Additional members to protect from accidental kicks (group-specific role checks also apply).
OPENCHAT_PROTECTED_MEMBER_IDS=
