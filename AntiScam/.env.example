# Secrets: configure only in local .env or hosting secrets. Never commit actual values.
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
PORT=3000
NODE_ENV=development
# Demo/local single-process storage; production requires 'supabase'.
STORAGE_DRIVER=local
STORAGE_FILE=./data/local.json
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SIDE_SERVICE_ROLE_KEY
# The default is safe: no real moderation takes place.
DRY_RUN=true
# Configure ONLY once a verified OpenChat connector has been deployed.
# OPENCHAT_BRIDGE_URL=https://YOUR_CONNECTOR_HOST
# OPENCHAT_BRIDGE_TOKEN=YOUR_CONNECTOR_BEARER_SECRET
# Optional AI second opinion; no automatic kicks based only on AI.
AI_ENABLED=false
# GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash-lite
